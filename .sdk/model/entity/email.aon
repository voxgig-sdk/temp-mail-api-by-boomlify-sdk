# Entity: email

main: kit: entity: email: {

  alias: field: {}

  fields: [
    {
      name: "createdAt"
      req: false
      short: "Creation timestamp"
      type: "`$STRING`"
    }
    {
      name: "domain"
      req: false
      short: "Domain to use for the email address."
      type: "`$STRING`"
    }
    {
      name: "email"
      req: false
      short: "The generated temporary email address"
      type: "`$STRING`"
    }
    {
      name: "expiresAt"
      req: false
      short: "Expiration timestamp of the email address"
      type: "`$STRING`"
    }
    {
      name: "expiry"
      req: false
      short: "Expiry duration for the email address"
      type: "`$STRING`"
    }
    {
      name: "token"
      req: false
      short: "Access token for managing this email address"
      type: "`$STRING`"
    }
    {
      name: "username"
      req: false
      short: "Desired username for the email address."
      type: "`$STRING`"
    }
  ]

  name: "email"
  op: {
    create: {
      name: "create"
      points: [
        {
          method: "POST"
          orig: "/email/create"
          parts: [
            "email"
            "create"
          ]
          select: {
            "$action": "create"
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
